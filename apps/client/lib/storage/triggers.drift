import 'tables/tables.dart';

-- A row's collection never changes; moving to another collection is a copy.

CREATE TRIGGER decks_collection_immutable
BEFORE UPDATE OF collection_id ON decks
WHEN NEW.collection_id IS NOT OLD.collection_id
BEGIN
  SELECT RAISE(ABORT, 'collection_id is immutable');
END;

CREATE TRIGGER tags_collection_immutable
BEFORE UPDATE OF collection_id ON tags
WHEN NEW.collection_id IS NOT OLD.collection_id
BEGIN
  SELECT RAISE(ABORT, 'collection_id is immutable');
