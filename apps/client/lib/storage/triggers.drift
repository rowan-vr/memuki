-- Review events are never changed; an undo is a new event.

CREATE TRIGGER review_events_append_only
BEFORE UPDATE ON review_events
BEGIN
  SELECT RAISE(ABORT, 'review events are append-only');
END;

-- Preset versions are never changed; editing a preset adds a version.

CREATE TRIGGER preset_versions_append_only
BEFORE UPDATE ON preset_versions
BEGIN
  SELECT RAISE(ABORT, 'preset versions are append-only');
END;
