-- Every update of a synced row must stamp a new timestamp. Changes are found
-- for the outbox by their timestamp, so an update that keeps the old one
-- would never be synced.

CREATE TRIGGER collections_hlc_changes
BEFORE UPDATE ON collections
WHEN NEW.hlc IS OLD.hlc
BEGIN
  SELECT RAISE(ABORT, 'hlc must change on every update');
END;

CREATE TRIGGER decks_hlc_changes
BEFORE UPDATE ON decks
WHEN NEW.hlc IS OLD.hlc
BEGIN
  SELECT RAISE(ABORT, 'hlc must change on every update');
END;

